{
  "expo": {
    "name": "SplitEasy",
    "slug": "spliteasy",
    "version": "1.0.0",
    "scheme": "spliteasy",
    "newArchEnabled": true,
    "extra": {
      "eas": {
        "projectId": "8b2b8bc5-b15d-492a-ba24-d7c554959c46"
      }
    },
    "platforms": ["ios", "android"],
    "splash": {
      "backgroundColor": "#5C7AEA",
      "resizeMode": "native"
    },
    "ios": {
      "bundleIdentifier": "com.spliteasy.app",
      "supportsTablet": false,
      "deploymentTarget": "16.0"
    },
    "android": {
      "package": "com.spliteasy.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen"
    ]
  }
}
